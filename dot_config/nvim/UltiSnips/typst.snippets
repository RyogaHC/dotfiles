snippet mk "Math" wA
$${1}$`!p
if t[2] and t[2][0] not in [',', '.', '?', '-', ' ']:
	snip.rv = ' '
else:
	snip.rv = ''
`$2
endsnippet

snippet tmp "Template" bA
#set text(lang: "ja")

#let maketitle(title, name) = align(
  center + horizon,
  [
  #text(
    size: 1cm,
    [
    	#title
    ]
  )

  #text(
    size: 0.5cm,
    [
    #name
    ]
    )

  #pagebreak()
  ]
)

#let kadai(num, a, kekka, kosatu) = [
  == 課題 #num
  #a
  === 結果
  #kekka
  === 考察
  #kosatu
]

$0
endsnippet

snippet dm "Display Math" wA
$
${1:${VISUAL}}
$
$0
endsnippet

snippet // "Fraction" iA
($1)/($2)$0
endsnippet

snippet / "Fraction" i
(${VISUAL})/($1)$0
endsnippet

snippet '((\d+)|(\d*)(\\)?([A-Za-z]+)((\^|_)(\{\d+\}|\d))*)/' "symbol frac" wrA
(`!p snip.rv = match.group(1)`)/($1)$0
endsnippet

snippet '([A-Za-z])(\d)' "auto subscript" wrA
`!p snip.rv = match.group(1)`_`!p snip.rv = match.group(2)`
endsnippet

snippet '([A-Za-z])_(\d\d)' "auto subscript2" wrA
`!p snip.rv = match.group(1)`_{`!p snip.rv = match.group(2)`}
endsnippet

snippet lr "left( right)" i
(${1:${VISUAL}}) $0
endsnippet

snippet lrb "left\{ right\}" i
{${1:${VISUAL}}} $0
endsnippet

snippet lrs "left\[ right\]" i
[${1:${VISUAL}}] $0
endsnippet

snippet lr| "left| right|" i
|${1:${VISUAL}}| $0
endsnippet

snippet lim "limit" w
lim_($1 -> $2) $0
endsnippet

snippet int "integral" w
integral $0
endsnippet

snippet sq "\sqrt{}" iA
sqrt(${1:${VISUAL}}) $0
endsnippet

snippet -= "equals" iA
&= $1 \\$0
endsnippet

snippet sr "^2" iA
^2
endsnippet

snippet cb "^3" iA
^3
endsnippet

snippet td "to the ... power" iA
^($1)$0
endsnippet

snippet __ "subscript" iA
_($1)$0
endsnippet

snippet ** "cdot" iA
dot 
endsnippet

snippet "(\\?\w+)(,\.|\.,)" "Vector postfix" riA
arrow(`!p snip.rv=match.group(1)`)
endsnippet

priority 10
snippet "bar" "bar" riA
overline{$1}$0
endsnippet

priority 100
snippet "([a-zA-Z])bar" "bar" riA
overline{`!p snip.rv=match.group(1)`}
endsnippet

snippet kadai "kadai"
#kadai(
  [$1],
  [$2],
  [$3],
  [$4]
)
endsnippet	
